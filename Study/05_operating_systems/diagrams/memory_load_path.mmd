%% Module 1 - what actually happens on one load
flowchart LR
  subgraph CORE["Core"]
    LSU["Load / store unit"]
  end

  subgraph XLAT["Address translation"]
    DTLB["L1 dTLB<br/>~64 entries"]
    STLB["STLB (L2 TLB)<br/>~1.5-2k entries"]
    PW["Hardware page walker<br/>4 levels"]
    PWC["Page-walk caches<br/>upper-level PTEs"]
  end

  subgraph DATA["Data hierarchy"]
    L1D["L1d<br/>32-48 KiB"]
    L2["L2<br/>0.5-2 MiB per core"]
    L3["L3 shared<br/>coherence point"]
    DRAM["DRAM<br/>64 B lines"]
  end

  LSU -- "virtual address" --> DTLB
  DTLB -- "miss" --> STLB
  STLB -- "miss" --> PW
  PW --> PWC
  PW -. "the walk is 1-4 loads<br/>into the same caches" .-> L2

  LSU -- "physical address" --> L1D
  L1D -- "miss" --> L2
  L2 -- "miss" --> L3
  L3 -- "miss" --> DRAM
