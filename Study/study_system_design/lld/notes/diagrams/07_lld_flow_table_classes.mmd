%% lld/04 - class structure of the Capstone 2 packet filter
classDiagram
  class PacketSource {
    <<interface>>
    +poll(batch) size_t
  }
  class XdpSource {
    -umem
    -fill_ring
    -rx_ring
    +poll(batch) size_t
  }
  class PcapReplaySource {
    +poll(batch) size_t
  }

  class FlowTable {
    -FlowBucket* buckets
    -uint64_t hash_key
    +lookup(tuple) FlowState*
    +insert(tuple) FlowState*
    +age(budget) void
  }
  class FlowBucket {
    +atomic~uint64~ keys[4]
    +atomic~uint32~ vals[4]
    +atomic~uint32~ epochs[4]
  }

  class EpochManager {
    +enter(tid) void
    +exit(tid) void
    +retire(ptr, deleter) void
  }
  class RuleSet {
    -rules
    +match(tuple) Action
  }
  class PerCoreStats {
    +bump(core, counter) void
    +snapshot() Totals
  }
  class Classifier {
    +run() void
  }

  PacketSource <|.. XdpSource
  PacketSource <|.. PcapReplaySource
  Classifier --> PacketSource : reads batches
  Classifier --> FlowTable : lookup / insert
  Classifier --> PerCoreStats : bump
  FlowTable *-- FlowBucket : one cache line each
  FlowTable --> EpochManager : safe reclamation
  RuleSet --> EpochManager : published by control thread
  Classifier --> RuleSet : match on miss (slow path)
