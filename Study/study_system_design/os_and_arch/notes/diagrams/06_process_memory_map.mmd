%% os_and_arch/07 - what a 64-bit process address space looks like
flowchart TD
  subgraph USER["User space (lower half of the canonical range)"]
    T["Text / .rodata<br/>file-backed, read-only, shared"]
    DA["Data / BSS<br/>private, copy-on-write after fork"]
    H["Heap<br/>grows up via brk / mmap"]
    M["mmap region<br/>shared libs, anonymous maps,<br/>DMA rings mapped from a driver"]
    ST["Stack<br/>grows down, guard page below"]
    V["vDSO + vvar<br/>clock_gettime with NO syscall"]
  end

  subgraph KERN["Kernel space"]
    K["Direct map, vmalloc, per-cpu areas<br/>inaccessible from user mode<br/>split into its own page tables under KPTI"]
  end

  T --> DA --> H --> M --> ST --> V --> K
